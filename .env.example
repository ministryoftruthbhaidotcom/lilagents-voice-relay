# Copy this file to ".env" and fill in your real values. NEVER commit .env.

# Your Google Gemini API keys, the ONLY place they live. They stay on the server.
# Use keys from projects with NO billing, so Google's free tier pays for everyday calls.
# Get them free at https://aistudio.google.com/apikey (the Live API has a free tier).
# Several free keys, comma-separated, each from its OWN project (the free limits are per project):
# new calls are shared out among them, the least busy first.
GEMINI_API_KEYS=AIza...,AIza...
# Or just one (still works; it joins GEMINI_API_KEYS when both are set):
# GEMINI_API_KEY=AIza...

# Optional: a key from a project WITH billing (prepaid credit). Used only when Google refuses every
# free key (their limit, or the keys themselves); a refused key rests KEY_REST_MINUTES before it's first again.
# GEMINI_API_KEY_PAID=AIza...
# KEY_REST_MINUTES=10

# Port the relay listens on (most hosts set PORT automatically).
PORT=8787

# Gemini Live model with native audio (most natural, emotional voice).
LIVE_MODEL=gemini-3.1-flash-live-preview

# Per-character prebuilt voices (Gemini built-ins: Aoede, Charon, Kore, Puck, Fenrir, …).
VOICE_JOSH=Charon
VOICE_HOPE=Aoede

# Optional quick-test codes (comma-separated). For real use, manage codes.json instead.
# INVITE_CODES=TEST-1234,DEMO-5678

# The exclusive build's download link, revealed by /verify when a code checks out.
EXCLUSIVE_DOWNLOAD_URL=https://github.com/ministryoftruthbhaidotcom/lilagents-app/releases/latest/download/LilAgents-pro-bundle.zip

# Comma-separated browser origins allowed to call /verify (your website). Leave blank
# to allow any origin. Example: https://lilagents.app,https://www.lilagents.app
ALLOWED_ORIGINS=

# PC tasks' steps on this key when the user's own key is refused (POST /generate). Daily caps,
# per install and for everyone (UTC days). Defaults: 300 and 3000.
# GENERATE_PER_CLIENT_DAY=300
# GENERATE_TOTAL_DAY=3000
